#!/bin/sh
# Use the existing environment without installing packages during a commit.
if [ -x .venv/bin/python ]; then
    interpreter=.venv/bin/python
elif [ -x .venv/Scripts/python.exe ]; then
    interpreter=.venv/Scripts/python.exe
else
    echo "Create .venv first: uv sync --locked --extra dev" >&2
    exit 1
fi
exec "$interpreter" scripts/check_git_conventions.py commit --file "$1"
